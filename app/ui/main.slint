import { Theme, Glyph } from "theme.slint";
import {
    Avatar, Button, ButtonKind, Icon, IconButton, MenuDivider, MenuRow, MenuSurface, ScrollArea, Slider, TextField,
} from "controls.slint";
import {
    Api, CallRow, ChannelRow, GuildRow, HintRow, MoreRow, ParticipantRow, PersonRow, PlaceRow, Row, RowKind,
    SectionRow, Target,
} from "rows.slint";
import { SettingsPage, SettingsUi, SettingsView } from "settings.slint";

export { Api, Row, RowKind, SettingsUi, SettingsView, Target }

// A call ringing us.
export struct IncomingCall {
    active: bool,
    channel-id: string,
    name: string,
    initial: string,
    group: bool,
}

component IncomingCallCard inherits Rectangle {
    in property <IncomingCall> call;
    callback accept();
    callback decline();

    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow;
    height: card.preferred-height;
    card := HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                pulse := Rectangle {
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: Theme.ok;
                    opacity: 0.4 + 0.6 * abs(sin(animation-tick() * 180deg / 0.8s));
                }
                Avatar {
                    x: 3px;
                    y: 3px;
                    size: 34px;
                    initial: root.call.initial;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.call.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.call.group ? "Group call" : "Incoming call";
                color: Theme.text-3;
                font-size: 11.5px;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.hang-up;
                active: true;
                clicked => { root.decline(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.phone;
                active: true;
                active-color: Theme.ok;
                clicked => { root.accept(); }
            }
        }
    }
}

// Our own voice connection, shown above the user panel.
export struct VoiceBar {
    active: bool,
    connected: bool,
    status: string,
    channel: string,
    guild: string,
}

component LoginView inherits Rectangle {
    in property <string> error;
    // The QR code to scan, and how far signing in with it has got: 0 waiting for a code, 1 shown,
    // 2 scanned, 3 not available.
    in property <image> qr-code;
    in property <int> qr-state;
    in property <string> qr-status;
    callback submit(string);
    callback help();

    background: Theme.bg;
    scroll := ScrollArea {
        content-height: login.preferred-height;
        login := VerticalLayout {
            width: scroll.width;
            height: self.preferred-height;
            y: max(0px, (scroll.height - self.preferred-height) / 2);
            padding: 28px;
            padding-top: 24px;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Image {
                    source: @image-url("../assets/icon.png");
                    width: 32px;
                    height: 32px;
                }
                Text {
                    text: "bardo";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Discord voice, and nothing else.";
                color: Theme.text-3;
                font-size: 13px;
                horizontal-alignment: center;
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 188px;
                    height: 188px;
                    border-radius: 10px;
                    background: root.qr-state == 3 ? Theme.raised : Theme.text;
                    animate background { duration: Theme.medium; }
                    if root.qr-state == 1 || root.qr-state == 2: Image {
                        x: 14px;
                        y: 14px;
                        width: 160px;
                        height: 160px;
                        source: root.qr-code;
                        image-rendering: pixelated;
                        opacity: root.qr-state == 2 ? 0.12 : 1;
                        animate opacity { duration: Theme.medium; }
                    }
                    if root.qr-state == 0: Text {
                        text: "Getting a code…";
                        color: Theme.bg.with-alpha(0.6);
                        font-size: 12px;
                    }
                    if root.qr-state == 2: Icon {
                        text: Glyph.phone;
                        font-size: 40px;
                        color: Theme.bg;
                    }
                    if root.qr-state == 3: Icon {
                        text: Glyph.clear;
                        font-size: 24px;
                        color: Theme.text-3;
                    }
                }
            }
            Text {
                text: root.qr-status != "" ? root.qr-status : "Scan it with the Discord app on your phone to sign in.";
                color: root.qr-state == 3 || (root.qr-state == 0 && root.qr-status != "") ? Theme.warn
                    : root.qr-state == 2 ? Theme.text : Theme.text-2;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                }
                Text {
                    text: "or use a token";
                    color: Theme.text-3;
                    font-size: 11.5px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }
            HorizontalLayout {
                Text {
                    text: "Discord token";
                    color: Theme.text-2;
                    font-size: 12px;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "How do I get it?";
                    color: help-touch.has-hover ? Theme.text : Theme.text-2;
                    font-size: 12px;
                    help-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.help(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                token := TextField {
                    password: true;
                    placeholder: "Paste your token";
                    accepted(text) => { root.submit(text); }
                }
                Button {
                    text: "Sign in";
                    enabled: token.text != "";
                    clicked => { root.submit(token.text); }
                }
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: "The token stays on this PC, in Windows Credential Manager.";
                color: Theme.text-3;
                font-size: 11.5px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// A newer bardo is out: offered, downloading, or failed to download.
component UpdateBar inherits Rectangle {
    in property <string> version;
    // 0 offered, 1 downloading, 2 failed.
    in property <int> state;
    // The fraction downloaded.
    in property <float> progress;
    callback install();
    callback open();
    callback dismiss();

    height: update-layout.preferred-height;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-strong;
    update-layout := HorizontalLayout {
        padding: 4px;
        padding-left: 12px;
        spacing: 2px;
        Text {
            text: root.state == 1 ? "Downloading bardo " + root.version + "… " + Math.round(root.progress * 100) + "%"
                : root.state == 2 ? "Could not update bardo"
                : "bardo " + root.version + " is out";
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.state == 0: Button {
            text: "Update";
            kind: ButtonKind.ghost;
            clicked => { root.install(); }
        }
        if root.state == 2: Button {
            text: "Download";
            kind: ButtonKind.ghost;
            clicked => { root.open(); }
        }
        // Hidden but still in place while downloading, so the bar keeps its height.
        IconButton {
            visible: root.state != 1;
            glyph: Glyph.clear;
            size: 30px;
            glyph-size: 10px;
            clicked => { root.dismiss(); }
        }
    }
}

component VoiceCard inherits Rectangle {
    in property <VoiceBar> voice;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.voice.connected ? Theme.ok : Theme.warn;
                    }
                }
                Text {
                    text: root.voice.status;
                    color: root.voice.connected ? Theme.ok : Theme.warn;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.voice.channel + "  ·  " + root.voice.guild;
                color: Theme.text-3;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.hang-up;
                active: true;
                clicked => { Api.leave-voice(); }
            }
        }
    }
}

component UserPanel inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <image> picture;
    in property <bool> speaking;
    in property <bool> connected;
    in property <string> status;
    in property <bool> muted;
    in property <bool> deafened;
    callback toggle-mute();
    callback toggle-deafen();
    callback open-settings();

    height: 54px;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 34px;
                initial: root.initial;
                picture: root.picture;
                speaking: root.speaking;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.connected ? Theme.ok : Theme.warn;
                    }
                }
                Text {
                    text: root.status;
                    color: Theme.text-3;
                    font-size: 11.5px;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: root.muted || root.deafened ? Glyph.mic-off : Glyph.mic;
                active: root.muted || root.deafened;
                clicked => { root.toggle-mute(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.headphones;
                active: root.deafened;
                slashed: root.deafened;
                clicked => { root.toggle-deafen(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.settings;
                clicked => { root.open-settings(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    // 0: sign in, 1: main.
    in property <int> screen;
    in property <[Row]> rows;
    in property <string> status;
    in property <bool> connected;
    in property <string> login-error;
    in property <image> qr-code;
    in property <int> qr-state;
    in property <string> qr-status;
    // A transient message shown above the footer.
    in property <string> notice;
    in property <VoiceBar> voice;
    in property <string> me-name;
    in property <string> me-initial;
    in property <image> me-picture;
    in property <bool> me-speaking;
    in property <bool> self-mute;
    in property <bool> self-deaf;
    in property <bool> settings-open;
    in property <IncomingCall> incoming;
    // A newer version, until dismissed.
    in-out property <string> update-version;
    in property <int> update-state;
    in property <float> update-progress;
    in-out property <string> search;
    callback sign-in(string);
    callback open-token-guide();
    callback install-update();
    callback open-update();
    callback dismiss-notice();
    callback toggle-mute();
    callback toggle-deafen();
    callback open-settings();
    callback search-edited(string);
    // Enter in the search field: join the first result.
    callback search-accepted();
    callback accept-call(string);
    callback decline-call(string);

    // The open context menu.
    property <Row> menu-row;
    property <length> menu-x;
    property <length> menu-y;
    // 0: actions, 1: "Move to" targets, 2: confirming "Disconnect".
    property <int> menu-page;
    property <float> menu-volume;
    // Bumped by Ctrl+K.
    property <int> search-focus;

    function open-menu(row: Row, x: length, y: length) {
        root.menu-row = row;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-page = 0;
        root.menu-volume = row.volume;
        menu.show();
    }

    title: "bardo";
    icon: @image-url("../assets/icon.png");
    preferred-width: 340px;
    preferred-height: 640px;
    min-width: 280px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: 13px;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if root.screen == 1 && event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.search-focus += 1;
                return accept;
            }
            reject
        }

        if root.screen == 0: LoginView {
            error: root.login-error;
            qr-code: root.qr-code;
            qr-state: root.qr-state;
            qr-status: root.qr-status;
            submit(token) => { root.sign-in(token); }
            help => { root.open-token-guide(); }
        }

        if root.screen == 1: VerticalLayout {
            Rectangle {
                height: 50px;
                background: Theme.panel;
                HorizontalLayout {
                    padding: 9px;
                    padding-left: 10px;
                    padding-right: 10px;
                    TextField {
                        focus-request: root.search-focus;
                        icon: Glyph.search;
                        placeholder: "Search channels and people";
                        shortcut: ["Ctrl", "K"];
                        text <=> root.search;
                        edited(text) => { root.search-edited(text); }
                        accepted => { root.search-accepted(); }
                        escape => {
                            root.search = "";
                            root.search-edited("");
                            keys.focus();
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if root.update-version != "": VerticalLayout {
                padding: 10px;
                padding-bottom: root.incoming.active ? 0px : 4px;
                UpdateBar {
                    version: root.update-version;
                    state: root.update-state;
                    progress: root.update-progress;
                    install => { root.install-update(); }
                    open => { root.open-update(); }
                    dismiss => { root.update-version = ""; }
                }
            }
            if root.incoming.active: VerticalLayout {
                padding: 10px;
                padding-bottom: 4px;
                IncomingCallCard {
                    call: root.incoming;
                    accept => { root.accept-call(root.incoming.channel-id); }
                    decline => { root.decline-call(root.incoming.channel-id); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                list := ScrollArea {
                    content-height: rows-layout.preferred-height;
                    rows-layout := VerticalLayout {
                        width: list.width;
                        padding-bottom: 10px;
                        for row in root.rows: Rectangle {
                            height: row.kind == RowKind.section ? 32px
                                : row.kind == RowKind.person ? 44px
                                : row.kind == RowKind.guild ? 34px
                                : row.kind == RowKind.channel ? 30px
                                : row.kind == RowKind.participant ? 30px
                                : row.kind == RowKind.more ? 26px
                                : row.kind == RowKind.place ? 40px
                                : row.kind == RowKind.call ? 40px
                                : 52px;
                            if row.kind == RowKind.section: SectionRow { item: row; }
                            if row.kind == RowKind.person: PersonRow {
                                item: row;
                                menu(x, y) => { root.open-menu(row, x, y); }
                            }
                            if row.kind == RowKind.guild: GuildRow {
                                item: row;
                                menu(x, y) => { root.open-menu(row, x, y); }
                            }
                            if row.kind == RowKind.channel: ChannelRow {
                                item: row;
                                menu(x, y) => { root.open-menu(row, x, y); }
                            }
                            if row.kind == RowKind.participant: ParticipantRow {
                                item: row;
                                clicked => {
                                    root.open-menu(row, self.absolute-position.x + 60px, self.absolute-position.y + self.height);
                                }
                                menu(x, y) => { root.open-menu(row, x, y); }
                            }
                            if row.kind == RowKind.more: MoreRow { item: row; }
                            if row.kind == RowKind.hint: HintRow { item: row; }
                            if row.kind == RowKind.place: PlaceRow { item: row; }
                            if row.kind == RowKind.call: CallRow { item: row; }
                        }
                    }
                }
                if root.rows.length == 0: Text {
                    text: root.search != "" ? "Nothing matches “" + root.search + "”"
                        : root.connected ? "No voice channels" : "Connecting to Discord…";
                    color: Theme.text-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if root.notice != "": Rectangle {
                    x: 10px;
                    width: parent.width - 20px;
                    height: notice-layout.preferred-height;
                    y: parent.height - self.height - 10px;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: Theme.shadow;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismiss-notice(); }
                    }
                    notice-layout := HorizontalLayout {
                        padding: 10px;
                        padding-left: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: start;
                            padding-top: 5px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.danger;
                            }
                        }
                        Text {
                            text: root.notice;
                            color: Theme.text;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            if root.voice.active: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if root.voice.active: VoiceCard { voice: root.voice; }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            UserPanel {
                name: root.me-name;
                initial: root.me-initial;
                picture: root.me-picture;
                speaking: root.me-speaking;
                connected: root.connected;
                status: root.status;
                muted: root.self-mute;
                deafened: root.self-deaf;
                toggle-mute => { root.toggle-mute(); }
                toggle-deafen => { root.toggle-deafen(); }
                open-settings => { root.open-settings(); }
            }
        }

        if root.screen == 1 && root.settings-open: SettingsPage { }
    }

    menu := PopupWindow {
        x: max(6px, min(root.menu-x, root.width - self.width - 6px));
        y: max(6px, min(root.menu-y, root.height - self.height - 6px));
        width: 236px;
        height: menu-layout.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        MenuSurface {
            menu-layout := VerticalLayout {
                padding: 4px;

                // People: participants and friends in voice.
                if (root.menu-row.kind == RowKind.participant || root.menu-row.kind == RowKind.person) && root.menu-page == 0: VerticalLayout {
                    HorizontalLayout {
                        padding: 8px;
                        padding-bottom: 6px;
                        spacing: 10px;
                        Avatar {
                            size: 30px;
                            initial: root.menu-row.initial;
                            picture: root.menu-row.picture;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.menu-row.label;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if root.menu-row.is-me || root.menu-row.sublabel != "": Text {
                                text: root.menu-row.is-me ? "You" : root.menu-row.sublabel;
                                color: Theme.text-3;
                                font-size: 11.5px;
                                overflow: elide;
                            }
                        }
                    }
                    if !root.menu-row.is-me: VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-bottom: 6px;
                        spacing: 2px;
                        HorizontalLayout {
                            Text {
                                text: "Volume";
                                color: Theme.text-2;
                                font-size: 12px;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: round(root.menu-volume) + "%";
                                color: Theme.text;
                                font-size: 12px;
                            }
                        }
                        Slider {
                            minimum: 0;
                            maximum: 200;
                            step: 5;
                            mark: 100;
                            value <=> root.menu-volume;
                            changed(value) => { Api.set-volume(root.menu-row.id, value); }
                        }
                    }
                    if !root.menu-row.is-me || root.menu-row.can-mute || root.menu-row.can-deafen: MenuDivider { }
                    if root.menu-row.call-id != "" && !root.menu-row.is-me: MenuRow {
                        text: "Call";
                        icon: Glyph.phone;
                        clicked => {
                            Api.start-call(root.menu-row.call-id);
                            menu.close();
                        }
                    }
                    if root.menu-row.kind == RowKind.person && root.menu-row.can-connect && !root.menu-row.current: MenuRow {
                        text: "Join their channel";
                        icon: Glyph.join;
                        clicked => {
                            Api.join-channel(root.menu-row.guild-id, root.menu-row.channel-id);
                            menu.close();
                        }
                    }
                    if !root.menu-row.is-me: MenuRow {
                        text: "Mute for me";
                        icon: Glyph.speaker-off;
                        toggle: root.menu-row.local-mute ? 1 : 0;
                        clicked => {
                            Api.set-local-mute(root.menu-row.id, !root.menu-row.local-mute);
                            menu.close();
                        }
                    }
                    if !root.menu-row.is-me && (root.menu-row.can-mute || root.menu-row.can-deafen || root.menu-row.can-move): MenuDivider { }
                    if root.menu-row.can-mute: MenuRow {
                        text: "Server mute";
                        icon: Glyph.mic-off;
                        toggle: root.menu-row.server-mute ? 1 : 0;
                        clicked => {
                            Api.set-server-mute(root.menu-row.guild-id, root.menu-row.id, !root.menu-row.server-mute);
                            menu.close();
                        }
                    }
                    if root.menu-row.can-deafen: MenuRow {
                        text: "Server deafen";
                        icon: Glyph.headphones;
                        toggle: root.menu-row.server-deaf ? 1 : 0;
                        clicked => {
                            Api.set-server-deafen(root.menu-row.guild-id, root.menu-row.id, !root.menu-row.server-deaf);
                            menu.close();
                        }
                    }
                    if root.menu-row.can-move && root.menu-row.targets.length > 0: MenuRow {
                        text: "Move to";
                        icon: Glyph.move;
                        submenu: true;
                        clicked => { root.menu-page = 1; }
                    }
                    if root.menu-row.can-move: MenuRow {
                        text: "Disconnect";
                        icon: Glyph.hang-up;
                        danger: true;
                        clicked => { root.menu-page = 2; }
                    }
                }

                // "Move to": the channels a participant can be moved to.
                if root.menu-row.kind == RowKind.participant && root.menu-page == 1: VerticalLayout {
                    MenuRow {
                        text: "Move " + root.menu-row.label + " to";
                        icon: Glyph.back;
                        clicked => { root.menu-page = 0; }
                    }
                    MenuDivider { }
                    Flickable {
                        height: min(targets.preferred-height, 300px);
                        content-height: targets.preferred-height;
                        targets := VerticalLayout {
                            for target in root.menu-row.targets: MenuRow {
                                text: target.name;
                                icon: Glyph.speaker;
                                clicked => {
                                    Api.move-member(root.menu-row.guild-id, root.menu-row.id, target.id);
                                    menu.close();
                                }
                            }
                        }
                    }
                }

                // Disconnecting someone from voice, confirmed first.
                if root.menu-row.kind == RowKind.participant && root.menu-page == 2: VerticalLayout {
                    VerticalLayout {
                        property <bool> me: root.menu-row.is-me;
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "Disconnect " + (parent.me ? "yourself" : root.menu-row.label) + "?";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "From voice only, not from the server. "
                                + (parent.me ? "You" : "They") + " can join again.";
                            color: Theme.text-3;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                    MenuDivider { }
                    MenuRow {
                        text: "Disconnect";
                        icon: Glyph.hang-up;
                        danger: true;
                        clicked => {
                            Api.disconnect-member(root.menu-row.guild-id, root.menu-row.id);
                            menu.close();
                        }
                    }
                    MenuRow {
                        text: "Cancel";
                        icon: Glyph.back;
                        clicked => { root.menu-page = 0; }
                    }
                }

                if root.menu-row.kind == RowKind.guild: VerticalLayout {
                    MenuRow {
                        text: root.menu-row.pinned ? "Unpin server" : "Pin server";
                        icon: root.menu-row.pinned ? Glyph.unpin : Glyph.pin;
                        clicked => {
                            Api.pin-guild(root.menu-row.id, !root.menu-row.pinned);
                            menu.close();
                        }
                    }
                    MenuRow {
                        text: "Show empty channels";
                        icon: Glyph.eye;
                        toggle: root.menu-row.show-empty ? 1 : 0;
                        clicked => {
                            Api.toggle-empty(root.menu-row.id);
                            menu.close();
                        }
                    }
                    MenuRow {
                        text: root.menu-row.expanded ? "Collapse" : "Expand";
                        icon: root.menu-row.expanded ? Glyph.collapse : Glyph.chevron-down;
                        clicked => {
                            Api.toggle-guild(root.menu-row.id);
                            menu.close();
                        }
                    }
                }

                if root.menu-row.kind == RowKind.channel: VerticalLayout {
                    if root.menu-row.current: MenuRow {
                        text: "Leave channel";
                        icon: Glyph.hang-up;
                        danger: true;
                        clicked => {
                            Api.leave-voice();
                            menu.close();
                        }
                    }
                    if !root.menu-row.current: MenuRow {
                        text: "Join channel";
                        icon: Glyph.join;
                        enabled: root.menu-row.can-connect;
                        clicked => {
                            Api.join-channel(root.menu-row.guild-id, root.menu-row.id);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

// The notification area icon: click to show bardo, right-click for quick actions.
export component BardoTray inherits SystemTrayIcon {
    in property <bool> connected;
    in property <bool> muted;
    in property <bool> deafened;
    in property <bool> in-voice;
    // The hover text.
    in property <string> status-text: "bardo";
    callback show-window();
    callback toggle-mute();
    callback toggle-deafen();
    callback leave-voice();
    callback quit();

    // A red dot while muted, so it shows at a glance.
    icon: root.muted ? @image-url("../assets/tray-muted.png") : @image-url("../assets/icon.png");
    tooltip: root.status-text;
    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Open bardo";
            activated => { root.show-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.muted ? "Unmute" : "Mute";
            enabled: root.connected;
            activated => { root.toggle-mute(); }
        }
        MenuItem {
            title: root.deafened ? "Undeafen" : "Deafen";
            enabled: root.connected;
            activated => { root.toggle-deafen(); }
        }
        if root.in-voice: MenuItem {
            title: "Leave voice";
            activated => { root.leave-voice(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit bardo";
            activated => { root.quit(); }
        }
    }
}
