import { Button, LineEdit, ListView, Slider } from "std-widgets.slint";

export enum RowKind { guild, channel, participant }

// A voice channel someone can be moved to.
export struct Target {
    id: string,
    name: string,
}

// Our own voice connection, shown in the bar at the bottom.
export struct VoiceBar {
    active: bool,
    connected: bool,
    status: string,
    channel: string,
    guild: string,
    muted: bool,
    deafened: bool,
}

export struct Row {
    kind: RowKind,
    id: string,
    label: string,
    guild-id: string,
    // Guild rows.
    expanded: bool,
    // Channel rows.
    count: int,
    limit: int,
    can-connect: bool,
    // We are in (or joining) this channel.
    current: bool,
    // Participant rows.
    initial: string,
    self-mute: bool,
    self-deaf: bool,
    server-mute: bool,
    server-deaf: bool,
    live: bool,
    speaking: bool,
    is-me: bool,
    // Local playback settings.
    local-mute: bool,
    volume: int,
    // Moderation actions allowed on this participant.
    can-mute: bool,
    can-deafen: bool,
    can-move: bool,
    targets: [Target],
}

global Theme {
    out property <color> background: #16171a;
    out property <color> hover: #24262b;
    out property <color> card: #202227;
    out property <color> scrim: #000000a0;
    out property <color> text: #e6e7ea;
    out property <color> muted-text: #8b9099;
    out property <color> danger: #e5484d;
    out property <color> ok: #3fb950;
    out property <color> warn: #d29922;
    out property <color> live: #e5484d;
    out property <color> avatar: #3a3e46;
    out property <color> speaking: #3fb950;
    out property <string> icon-font: "Segoe Fluent Icons";
}

// Segoe Fluent Icons code points.
global Glyph {
    out property <string> chevron-down: "\u{E70D}";
    out property <string> chevron-right: "\u{E76C}";
    out property <string> speaker: "\u{E767}";
    out property <string> speaker-off: "\u{E74F}";
    out property <string> mic: "\u{E720}";
    out property <string> mic-off: "\u{EC54}";
    out property <string> headphones: "\u{E7F6}";
    out property <string> hang-up: "\u{E778}";
}

component Icon inherits Text {
    font-family: Theme.icon-font;
    font-size: 14px;
    color: Theme.muted-text;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Headphones with a slash across them: deafened.
component DeafIcon inherits Rectangle {
    in property <color> tint: Theme.muted-text;
    width: 16px;
    Icon {
        text: Glyph.headphones;
        color: root.tint;
    }
    Path {
        width: 12px;
        height: 12px;
        commands: "M 0 0 L 12 12";
        stroke: root.tint;
        stroke-width: 1.5px;
    }
}

component GuildRow inherits Rectangle {
    in property <Row> item;
    callback toggled();

    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => { root.toggled(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Icon {
            width: 14px;
            font-size: 10px;
            text: root.item.expanded ? Glyph.chevron-down : Glyph.chevron-right;
        }
        Text {
            text: root.item.label;
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component ChannelRow inherits Rectangle {
    in property <Row> item;
    callback join();

    background: touch.has-hover && root.item.can-connect ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: root.item.can-connect && !root.item.current ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.item.can-connect && !root.item.current {
                root.join();
            }
        }
    }
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 10px;
        spacing: 6px;
        Icon {
            width: 16px;
            text: Glyph.speaker;
            color: root.item.current ? Theme.ok : Theme.muted-text;
        }
        Text {
            text: root.item.label;
            color: root.item.current ? Theme.ok : root.item.count > 0 ? Theme.text : Theme.muted-text;
            font-weight: root.item.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.limit > 0: Text {
            text: root.item.count + "/" + root.item.limit;
            color: Theme.muted-text;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component ParticipantRow inherits Rectangle {
    in property <Row> item;
    callback server-mute(bool);
    callback server-deafen(bool);
    callback move-to(string);
    callback disconnect();
    callback local-mute(bool);
    callback edit-volume();

    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea { }
    ContextMenuArea {
        enabled: !root.item.is-me || root.item.can-mute || root.item.can-deafen || root.item.can-move;
        Menu {
            if !root.item.is-me: MenuItem {
                title: "Volume (" + root.item.volume + " %)…";
                activated => { root.edit-volume(); }
            }
            if !root.item.is-me: MenuItem {
                title: "Mute locally";
                checked: root.item.local-mute;
                activated => { root.local-mute(!root.item.local-mute); }
            }
            MenuSeparator { }
            if root.item.can-mute: MenuItem {
                title: "Server mute";
                checked: root.item.server-mute;
                activated => { root.server-mute(!root.item.server-mute); }
            }
            if root.item.can-deafen: MenuItem {
                title: "Server deafen";
                checked: root.item.server-deaf;
                activated => { root.server-deafen(!root.item.server-deaf); }
            }
            if root.item.can-move && root.item.targets.length > 0: Menu {
                title: "Move to";
                for target in root.item.targets: MenuItem {
                    title: target.name;
                    activated => { root.move-to(target.id); }
                }
            }
            if root.item.can-move: MenuItem {
                title: "Disconnect";
                activated => { root.disconnect(); }
            }
        }
    }
    HorizontalLayout {
        padding-left: 44px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.avatar;
                border-width: root.item.speaking ? 2px : 0px;
                border-color: Theme.speaking;
                Text {
                    text: root.item.initial;
                    color: Theme.text;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.item.label;
            color: root.item.local-mute ? Theme.muted-text : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.item.is-me && !root.item.local-mute && root.item.volume != 100: Text {
            text: root.item.volume + "%";
            color: Theme.muted-text;
            font-size: 10px;
            vertical-alignment: center;
        }
        if root.item.live: VerticalLayout {
            alignment: center;
            Rectangle {
                background: Theme.live;
                border-radius: 3px;
                height: 14px;
                width: live-text.preferred-width + 8px;
                live-text := Text {
                    text: "LIVE";
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                }
            }
        }
        if root.item.local-mute: Icon {
            width: 16px;
            text: Glyph.speaker-off;
            color: Theme.warn;
        }
        if root.item.self-mute || root.item.server-mute: Icon {
            width: 16px;
            text: Glyph.mic-off;
            color: root.item.server-mute ? Theme.danger : Theme.muted-text;
        }
        if root.item.self-deaf || root.item.server-deaf: DeafIcon {
            tint: root.item.server-deaf ? Theme.danger : Theme.muted-text;
        }
    }
}

// Bottom sheet with a slider for one participant's local volume.
component VolumeSheet inherits Rectangle {
    in property <string> name;
    in-out property <float> value;
    callback changed(int);
    callback close();

    background: Theme.scrim;
    TouchArea {
        clicked => { root.close(); }
    }
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        height: layout.preferred-height;
        y: parent.height - self.height - 12px;
        background: Theme.card;
        border-radius: 8px;
        // Keeps clicks on the card from closing the sheet.
        TouchArea { }
        layout := VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.name;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: round(root.value) + " %";
                    color: Theme.muted-text;
                }
            }
            Slider {
                minimum: 0;
                maximum: 200;
                step: 5;
                value <=> root.value;
                // Clicking the track lands anywhere; snap to the step like the keyboard does.
                changed(value) => {
                    root.value = round(value / 5) * 5;
                    root.changed(root.value);
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "Reset";
                    clicked => {
                        root.value = 100;
                        root.changed(100);
                    }
                }
                Button {
                    text: "Done";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    in property <bool> slashed;
    in property <color> active-color: Theme.danger;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? Theme.background : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Icon {
        font-size: 16px;
        text: root.glyph;
        color: root.active ? root.active-color : Theme.text;
    }
    if root.slashed: Path {
        width: 14px;
        height: 14px;
        commands: "M 0 0 L 14 14";
        stroke: root.active-color;
        stroke-width: 1.5px;
    }
}

component VoiceBarView inherits Rectangle {
    in property <VoiceBar> voice;
    callback toggle-mute();
    callback toggle-deafen();
    callback leave();

    background: Theme.card;
    HorizontalLayout {
        padding: 8px;
        padding-left: 14px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.voice.status;
                color: root.voice.connected ? Theme.ok : Theme.warn;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.voice.channel + " / " + root.voice.guild;
                color: Theme.muted-text;
                font-size: 11px;
                overflow: elide;
            }
        }
        IconButton {
            glyph: root.voice.muted || root.voice.deafened ? Glyph.mic-off : Glyph.mic;
            active: root.voice.muted || root.voice.deafened;
            clicked => { root.toggle-mute(); }
        }
        IconButton {
            glyph: Glyph.headphones;
            active: root.voice.deafened;
            slashed: root.voice.deafened;
            clicked => { root.toggle-deafen(); }
        }
        IconButton {
            glyph: Glyph.hang-up;
            active: true;
            clicked => { root.leave(); }
        }
    }
}

component LoginView inherits Rectangle {
    in property <string> error;
    callback submit(string);

    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 12px;
        Text {
            text: "bardo";
            font-size: 28px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "Paste your Discord token. It is stored in Windows Credential Manager.";
            color: Theme.muted-text;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        token := LineEdit {
            input-type: password;
            placeholder-text: "Token";
            accepted(text) => { root.submit(text); }
        }
        Button {
            text: "Sign in";
            primary: true;
            enabled: token.text != "";
            clicked => { root.submit(token.text); }
        }
        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    in property <int> screen;
    in property <[Row]> rows;
    in property <string> status;
    in property <bool> connected;
    in property <string> login-error;
    // A transient error shown under the header.
    in property <string> notice;
    // The participant whose volume is being edited; empty when the sheet is closed.
    in property <string> volume-user;
    in property <string> volume-name;
    in-out property <float> volume-value;
    in property <VoiceBar> voice;
    callback sign-in(string);
    callback sign-out();
    callback toggle-guild(string);
    callback dismiss-notice();
    callback set-server-mute(string, string, bool);
    callback set-server-deafen(string, string, bool);
    callback move-member(string, string, string);
    callback disconnect-member(string, string);
    callback set-local-mute(string, bool);
    callback edit-volume(string, string);
    callback set-volume(string, int);
    callback close-volume();
    callback join-channel(string, string);
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();

    title: "bardo";
    preferred-width: 340px;
    preferred-height: 600px;
    min-width: 260px;
    min-height: 360px;
    background: Theme.background;

    if root.screen == 0: LoginView {
        error: root.login-error;
        submit(token) => { root.sign-in(token); }
    }

    if root.screen == 1: VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            padding-left: 14px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.connected ? Theme.ok : Theme.warn;
                }
            }
            Text {
                text: root.status;
                color: Theme.muted-text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: "Sign out";
                clicked => { root.sign-out(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.hover;
        }
        if root.notice != "": Rectangle {
            background: Theme.card;
            TouchArea {
                clicked => { root.dismiss-notice(); }
            }
            HorizontalLayout {
                padding: 8px;
                padding-left: 14px;
                Text {
                    text: root.notice;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
            }
        }
        if root.connected && root.rows.length == 0: Text {
            text: "No voice channels";
            color: Theme.muted-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        ListView {
            vertical-stretch: 1;
            for row in root.rows: Rectangle {
                height: row.kind == RowKind.guild ? 34px : row.kind == RowKind.channel ? 30px : 28px;
                if row.kind == RowKind.guild: GuildRow {
                    width: parent.width;
                    height: parent.height;
                    item: row;
                    toggled => { root.toggle-guild(row.id); }
                }
                if row.kind == RowKind.channel: ChannelRow {
                    width: parent.width;
                    height: parent.height;
                    item: row;
                    join => { root.join-channel(row.guild-id, row.id); }
                }
                if row.kind == RowKind.participant: ParticipantRow {
                    width: parent.width;
                    height: parent.height;
                    item: row;
                    server-mute(on) => { root.set-server-mute(row.guild-id, row.id, on); }
                    server-deafen(on) => { root.set-server-deafen(row.guild-id, row.id, on); }
                    move-to(channel) => { root.move-member(row.guild-id, row.id, channel); }
                    disconnect => { root.disconnect-member(row.guild-id, row.id); }
                    local-mute(on) => { root.set-local-mute(row.id, on); }
                    edit-volume => { root.edit-volume(row.id, row.label); }
                }
            }
        }
        if root.voice.active: VoiceBarView {
            voice: root.voice;
            toggle-mute => { root.toggle-mute(); }
            toggle-deafen => { root.toggle-deafen(); }
            leave => { root.leave-voice(); }
        }
    }

    if root.screen == 1 && root.volume-user != "": VolumeSheet {
        width: parent.width;
        height: parent.height;
        name: root.volume-name;
        value <=> root.volume-value;
        changed(volume) => { root.set-volume(root.volume-user, volume); }
        close => { root.close-volume(); }
    }
}
