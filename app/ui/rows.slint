// The rows of the main list: section headings, friends in voice, servers, channels, participants.

import { Theme, Glyph } from "theme.slint";
import { Avatar, Badge, Caption, Icon, IconButton, SlashedIcon } from "controls.slint";

export enum RowKind {
    // A heading such as "Friends in voice"; `expanded` and `collapsible` apply.
    section,
    // Someone in voice somewhere: a friend, or a search result. Click joins their channel.
    person,
    guild,
    channel,
    participant,
    // "3 empty channels": shows or hides a server's empty channels.
    more,
    // A line of help text.
    hint,
    // A channel found by search; with an empty guild-id, a DM or group to call.
    place,
    // A call in a DM or group; `pinned` marks groups.
    call,
}

// A voice channel someone can be moved to.
export struct Target {
    id: string,
    name: string,
}

export struct Row {
    kind: RowKind,
    id: string,
    label: string,
    sublabel: string,
    guild-id: string,
    // Person and place rows: the channel to join.
    channel-id: string,
    expanded: bool,
    collapsible: bool,
    pinned: bool,
    // Guild rows: empty channels are listed.
    show-empty: bool,
    // Participants in a channel, people in a server's voice channels, empty channels, or a
    // section's entries.
    count: int,
    limit: int,
    can-connect: bool,
    // Our channel, or someone in it.
    current: bool,
    initial: string,
    self-mute: bool,
    self-deaf: bool,
    server-mute: bool,
    server-deaf: bool,
    live: bool,
    speaking: bool,
    is-me: bool,
    // Local playback settings.
    local-mute: bool,
    volume: int,
    // Moderation actions allowed on this participant.
    can-mute: bool,
    can-deafen: bool,
    can-move: bool,
    targets: [Target],
    // The DM channel to call this person in, if any.
    call-id: string,
}

// What the list's rows ask of the app.
export global Api {
    callback toggle-section(string);
    callback toggle-guild(string);
    callback toggle-empty(string);
    callback pin-guild(string, bool);
    // Joins a guild voice channel, or a call when the guild is empty.
    callback join-channel(string, string);
    // Joins a DM or group call and rings the others.
    callback start-call(string);
    callback leave-voice();
    callback set-server-mute(string, string, bool);
    callback set-server-deafen(string, string, bool);
    callback move-member(string, string, string);
    callback disconnect-member(string, string);
    callback set-local-mute(string, bool);
    callback set-volume(string, int);
}

// Mute, deafen and live badges at the end of a person or participant row.
component StatusIcons inherits HorizontalLayout {
    in property <Row> item;
    spacing: 4px;
    if root.item.live: VerticalLayout {
        alignment: center;
        Badge { text: "LIVE"; }
    }
    if root.item.local-mute: Icon {
        width: 16px;
        text: Glyph.speaker-off;
        font-size: 13px;
        color: Theme.warn;
    }
    if root.item.self-mute || root.item.server-mute: Icon {
        width: 16px;
        text: Glyph.mic-off;
        font-size: 13px;
        color: root.item.server-mute ? Theme.danger : Theme.text-3;
    }
    if root.item.self-deaf || root.item.server-deaf: SlashedIcon {
        glyph: Glyph.headphones;
        glyph-size: 13px;
        tint: root.item.server-deaf ? Theme.danger : Theme.text-3;
    }
}

// Base for rows: hover background and click / right-click handling with the pointer position in
// window coordinates (for menus).
component RowBase inherits Rectangle {
    in property <bool> clickable: true;
    in property <bool> highlighted;
    // A control inside the row is hovered; the row counts as hovered too.
    in property <bool> inner-hover;
    out property <bool> hovered: touch.has-hover || self.inner-hover;
    callback clicked();
    callback menu(length, length);

    background: root.highlighted ? Theme.active : root.hovered ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    touch := TouchArea {
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component SectionRow inherits RowBase {
    in property <Row> item;
    height: 32px;
    clickable: root.item.collapsible;
    clicked => {
        if root.item.collapsible {
            Api.toggle-section(root.item.id);
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 8px;
        spacing: 6px;
        Caption { text: root.item.label; }
        if root.item.count > 0: Caption {
            text: root.item.count;
            color: Theme.text-3.with-alpha(0.7);
        }
        Rectangle { horizontal-stretch: 1; }
        if root.item.collapsible: Icon {
            text: root.item.expanded ? Glyph.chevron-down : Glyph.chevron-right;
            font-size: 8px;
            color: Theme.text-3;
        }
    }
}

export component PersonRow inherits RowBase {
    in property <Row> item;
    property <bool> joinable: root.item.can-connect && !root.item.current;
    height: 44px;
    clickable: self.joinable;
    clicked => {
        if self.joinable {
            Api.join-channel(root.item.guild-id, root.item.channel-id);
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 30px;
                initial: root.item.initial;
                speaking: root.item.speaking;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.item.label;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.item.sublabel;
                color: root.item.current ? Theme.ok : Theme.text-3;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        if !root.hovered || !root.joinable: StatusIcons { item: root.item; }
        if root.hovered && root.joinable: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: join-text.preferred-width + 16px;
                border-radius: 11px;
                background: Theme.text;
                join-text := Text {
                    text: "Join";
                    color: Theme.bg;
                    font-size: 11.5px;
                    font-weight: 600;
                }
            }
        }
    }
}

export component GuildRow inherits RowBase {
    in property <Row> item;
    height: 34px;
    inner-hover: pin.hovered;
    clicked => { Api.toggle-guild(root.item.id); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Icon {
            width: 14px;
            font-size: 8px;
            text: root.item.expanded ? Glyph.chevron-down : Glyph.chevron-right;
            color: Theme.text-3;
        }
        Text {
            text: root.item.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.item.expanded && root.item.count > 0: HorizontalLayout {
            spacing: 4px;
            Icon {
                text: Glyph.people;
                font-size: 12px;
                color: Theme.text-3;
            }
            Text {
                text: root.item.count;
                color: Theme.text-2;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        // Always present (only faded out), so hovering it does not make it disappear.
        VerticalLayout {
            alignment: center;
            pin := IconButton {
                size: 24px;
                glyph-size: 11px;
                glyph: !root.item.pinned ? Glyph.pin : root.hovered ? Glyph.unpin : Glyph.pinned;
                opacity: root.hovered ? 1 : root.item.pinned ? 0.45 : 0;
                clicked => { Api.pin-guild(root.item.id, !root.item.pinned); }
            }
        }
    }
}

export component ChannelRow inherits RowBase {
    in property <Row> item;
    property <bool> joinable: root.item.can-connect && !root.item.current;
    height: 30px;
    clickable: self.joinable;
    highlighted: root.item.current;
    clicked => {
        if self.joinable {
            Api.join-channel(root.item.guild-id, root.item.id);
        }
    }
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 12px;
        spacing: 8px;
        Icon {
            width: 16px;
            text: Glyph.speaker;
            font-size: 13px;
            color: root.item.current ? Theme.ok : root.item.can-connect ? Theme.text-3 : Theme.text-3.with-alpha(0.5);
        }
        Text {
            text: root.item.label;
            color: root.item.current ? Theme.text : root.item.count > 0 ? Theme.text : Theme.text-2;
            font-size: 13px;
            font-weight: root.item.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.hovered && root.joinable: Text {
            text: "Join";
            color: Theme.text-2;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if !(root.hovered && root.joinable) && root.item.limit > 0: Text {
            text: root.item.count + "/" + root.item.limit;
            color: Theme.text-3;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }
}

export component ParticipantRow inherits RowBase {
    in property <Row> item;
    height: 30px;
    HorizontalLayout {
        padding-left: 50px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 24px;
                initial: root.item.initial;
                speaking: root.item.speaking;
            }
        }
        Text {
            text: root.item.label;
            color: root.item.local-mute ? Theme.text-3 : root.item.speaking ? Theme.text : Theme.text-2;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.item.is-me && !root.item.local-mute && root.item.volume != 100: Text {
            text: root.item.volume + "%";
            color: Theme.text-3;
            font-size: 11px;
            vertical-alignment: center;
        }
        StatusIcons { item: root.item; }
    }
}

export component MoreRow inherits RowBase {
    in property <Row> item;
    height: 26px;
    clicked => { Api.toggle-empty(root.item.guild-id); }
    HorizontalLayout {
        padding-left: 52px;
        padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.item.expanded ? "Hide empty channels"
                : root.item.count == 1 ? "1 empty channel" : root.item.count + " empty channels";
            color: root.hovered ? Theme.text-2 : Theme.text-3;
            font-size: 11.5px;
            vertical-alignment: center;
        }
        Icon {
            text: root.item.expanded ? Glyph.collapse : Glyph.chevron-down;
            font-size: 8px;
            color: Theme.text-3;
        }
    }
}

export component HintRow inherits Rectangle {
    in property <Row> item;
    height: text.preferred-height + 16px;
    text := Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.item.label;
        color: Theme.text-3;
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component PlaceRow inherits RowBase {
    in property <Row> item;
    property <bool> joinable: root.item.can-connect && !root.item.current;
    height: 40px;
    clickable: self.joinable;
    clicked => {
        if !self.joinable {
            return;
        }
        if root.item.guild-id == "" {
            Api.start-call(root.item.channel-id);
        } else {
            Api.join-channel(root.item.guild-id, root.item.channel-id);
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: root.item.guild-id == "" ? Glyph.phone : Glyph.speaker;
            color: root.item.current ? Theme.ok : Theme.text-3;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.item.label;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.item.sublabel;
                color: Theme.text-3;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        if root.item.count > 0: HorizontalLayout {
            spacing: 4px;
            Icon {
                text: Glyph.people;
                font-size: 12px;
                color: Theme.text-3;
            }
            Text {
                text: root.item.count;
                color: Theme.text-2;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

export component CallRow inherits RowBase {
    in property <Row> item;
    property <bool> joinable: !root.item.current;
    height: 40px;
    clickable: self.joinable;
    highlighted: root.item.current;
    clicked => {
        if self.joinable {
            Api.join-channel("", root.item.channel-id);
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: root.item.pinned ? Glyph.group : Glyph.phone;
            color: root.item.current ? Theme.ok : Theme.text-2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.item.label;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.sublabel;
                color: root.item.current ? Theme.ok : Theme.text-3;
                font-size: 11.5px;
                overflow: elide;
            }
        }
        if root.hovered && root.joinable: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: join-text.preferred-width + 16px;
                border-radius: 11px;
                background: Theme.text;
                join-text := Text {
                    text: "Join";
                    color: Theme.bg;
                    font-size: 11.5px;
                    font-weight: 600;
                }
            }
        }
    }
}
